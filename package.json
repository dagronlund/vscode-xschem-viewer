{
  "name": "vscode-xschem-viewer",
  "displayName": "Xschem Viewer (Local Libraries)",
  "version": "1.1.3",
  "description": "View local Xschem schematics, PDK symbols and project hierarchy.",
  "publisher": "barakh",
  "author": "Barak Hoffer",
  "license": "Apache-2.0",
  "icon": "xschem_logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/barakhoffer/vscode-xschem-viewer.git"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:plaintext"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && node scripts/build.mjs",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src test scripts *.json *.ts *.md"
  },
  "contributes": {
    "languages": [
      {
        "id": "xschem",
        "aliases": [
          "Xschem"
        ]
      }
    ],
    "grammars": [
      {
        "language": "xschem",
        "scopeName": "source.xschem",
        "path": "./syntaxes/xschem.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "xschem.viewXschem",
        "displayName": "Xschem",
        "selector": [
          {
            "filenamePattern": "*.sch"
          },
          {
            "filenamePattern": "*.sym"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "xschem.runSimulation",
        "title": "Run Xschem Simulation",
        "icon": "$(play)"
      },
      {
        "command": "xschem.editSchematic",
        "title": "Open in Xschem",
        "icon": "$(pencil)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "xschem.runSimulation",
          "group": "navigation",
          "when": "resourceExtname == .sch"
        },
        {
          "command": "xschem.editSchematic",
          "group": "navigation",
          "when": "resourceExtname == .sch"
        }
      ]
    },
    "configuration": {
      "title": "Xschem Viewer",
      "properties": {
        "xschem.libraryPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Ordered local library roots, including your installed Xschem device library and PDK libraries. Supports ${workspaceFolder}, ${workspaceFolder:name}, ${env:NAME} and ~. Relative paths start at the workspace folder. The containing file's directory is searched first, followed by these roots, the workspace root and XSCHEM_LIBRARY_PATH."
        },
        "xschem.simulationDirectory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Directory for saved SPICE waveforms and graph $netlist_dir references. Defaults to simulations under the workspace root. Supports the same variables as libraryPaths."
        },
        "xschem.graphLineWidthMult": {
          "type": "number",
          "default": 1.4,
          "exclusiveMinimum": 0,
          "scope": "resource",
          "description": "Default waveform trace width multiplier. A graph's saved linewidth_mult overrides this setting."
        },
        "xschem.executable": {
          "type": "string",
          "default": "xschem",
          "scope": "resource",
          "description": "Native Xschem executable or launcher script. Supports the same variables as libraryPaths."
        },
        "xschem.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional arguments passed to the native launcher as separate arguments, without a shell."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Preview local schematics; native launch commands require a trusted workspace.",
      "restrictedConfigurations": [
        "xschem.executable",
        "xschem.arguments",
        "xschem.libraryPaths",
        "xschem.simulationDirectory"
      ]
    }
  },
  "dependencies": {
    "panzoom": "^9.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
